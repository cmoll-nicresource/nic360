{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectBackupBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::nic360-backups-226541720866-us-east-1"
    },
    {
      "Sid": "ReadAndWriteUploadSnapshots",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::nic360-backups-226541720866-us-east-1/uploads/*"
    }
  ]
}
