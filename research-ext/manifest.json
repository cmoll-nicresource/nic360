{
  "manifest_version": 3,
  "name": "N360 Industry Clipper",
  "version": "1.0.1",
  "description": "N360 Industry Clipper imports journal articles into Nicotine360 as drafts for editorial review.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "identity"
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/research-extension-16.png",
      "32": "images/research-extension-32.png",
      "48": "images/research-extension-48.png",
      "128": "images/research-extension-128.png"
    },
    "default_title": "N360 Industry Clipper"
  },
  "icons": {
    "16": "images/research-extension-16.png",
    "32": "images/research-extension-32.png",
    "48": "images/research-extension-48.png",
    "128": "images/research-extension-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self';"
  },
  "key": ""
}
