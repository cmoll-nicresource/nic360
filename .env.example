# The site's own public URL (used in generated email/campaign links and Stripe redirects)
SITE_URL=http://localhost:3000

# StateNet-provided HTTPS iframe URL (not raw HTML). Only rendered for eligible members/staff.
STATENET_ITRAC_URL=

# Postgres connection string (Railway provides one in production)
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/nic360

# Any long random string
PAYLOAD_SECRET=change-me-to-a-long-random-string

# S3-compatible file storage (AWS S3 or Cloudflare R2). Leave unset in development to use local disk.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Stripe (event tickets only)
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Missing webhook verification configuration fails closed on hosted sites.
# Only isolated loopback development/test requests can opt into unsigned fixtures.
ALLOW_UNSAFE_LOCAL_WEBHOOKS=false
ALLOW_DESTRUCTIVE_LOCAL_SEED=false

# Mailchimp Marketing API — historical only. Used once to pull the old
# site's subscriber/interest data during migration (migration/*.ts); not an
# ongoing sender. MAILCHIMP_MODE stays 'simulated' — Mailchimp is not used
# to send anything live.
MAILCHIMP_API_KEY=
MAILCHIMP_MODE=simulated
MAILCHIMP_WEBHOOK_SECRET=

# Which sender ships publication issues: 'ses' (default) or 'mailchimp'
# (kept only as a fallback option — not actually used; see above).
EMAIL_PROVIDER=ses

# AWS SES — the one email system end to end: account email (verification,
# password reset, invites, via Payload's own adapter in payload.config.ts)
# and publication-issue bulk sends (src/lib/ses/) both use these same AWS
# credentials, but deliberately different from-addresses/MAIL FROM domains
# (SES_ACCOUNT_FROM_ADDRESS vs SES_FROM_ADDRESS below) — a newsletter
# send's bounce/complaint rate shouldn't be able to drag down
# deliverability for must-arrive account email like password resets.
# Leave SES_ACCESS_KEY_ID/SES_SECRET_ACCESS_KEY unset in development:
# account emails are logged to the console instead of sent, and
# SES_MODE=simulated logs publication sends to the ses-outbox collection.
# It never disables hosted SNS topic/signature verification.
SES_MODE=simulated
SES_SNS_TOPIC_ARN=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
# Optional dedicated, persistent HMAC secret; defaults to PAYLOAD_SECRET.
# Rotating this invalidates links in already-sent newsletters.
NEWSLETTER_UNSUBSCRIBE_SECRET=
SES_ACCOUNT_FROM_ADDRESS=no-reply@accounts.nicotine360.org
SES_FROM_ADDRESS=pubs@nicotine360.org

# Real migrated user data lives in non-local environments — this is the
# hard safety net against ever emailing one of them by accident. Default is
# safe: every outgoing account email and live newsletter test gets redirected to
# EMAIL_SAFE_MODE_REDIRECT_TO (subject line notes the real recipient), until
# an explicit EMAIL_SAFE_MODE=off turns that off. Combine with keeping the
# SES account in sandbox mode (AWS's own default for new accounts, which
# only delivers to verified identities) as a second, infrastructure-level
# backstop.
EMAIL_SAFE_MODE=on
EMAIL_SAFE_MODE_REDIRECT_TO=demo@nicotine360.org
# Live audience newsletter jobs are blocked while safe mode is on.
# SES_MODE=simulated only records previews and never marks an issue sent.
# Staff operations monitoring (disabled locally; enable after applying operationalAlerts.sql).
OPERATIONS_MONITOR_ENABLED=false
OPERATIONS_MONITOR_SINCE=
OPERATIONS_ALERT_EMAIL=
