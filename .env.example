# The site's own public URL (used in generated email/campaign links and Stripe redirects)
SITE_URL=http://localhost:3000

# Postgres connection string (Railway provides one in production)
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/nic360

# Any long random string
PAYLOAD_SECRET=change-me-to-a-long-random-string

# S3-compatible file storage (AWS S3 or Cloudflare R2). Leave unset in development to use local disk.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Stripe (event tickets only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mandrill SMTP (account email: verification, password reset, invites).
# Leave unset in development: emails are logged to the console instead of sent.
MANDRILL_SMTP_HOST=smtp.mandrillapp.com
MANDRILL_SMTP_PORT=587
MANDRILL_SMTP_USER=
MANDRILL_API_KEY=
MANDRILL_FROM_ADDRESS=no-reply@nicotine360.org

# Mailchimp Marketing API (newsletters)
MAILCHIMP_API_KEY=
MAILCHIMP_MODE=simulated
